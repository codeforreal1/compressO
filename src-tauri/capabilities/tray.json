{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray",
  "description": "Capability for the tray popover window (the macOS menu bar & the Windows system tray)",
  "platforms": ["macOS", "windows"],
  "local": true,
  "windows": ["tray"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "os:allow-platform"
  ]
}
