---
import { Image } from "astro:assets";
import CodeForRealLogo from "../assets/logo.png";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { href: "/#features", label: "Features" },
      { href: "/#download", label: "Download" },
      { href: "https://github.com/codeforreal1/compressO/releases", label: "Releases" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "https://github.com/codeforreal1/compressO", label: "Source code" },
      { href: "https://github.com/codeforreal1/compressO/issues", label: "Report an issue" },
      { href: "mailto:compresso@codeforreal.com", label: "Contact" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand">
          <img src="/app-icon.png" alt="" width="28" height="28" />
          <span>CompressO</span>
        </a>
        <p>Compress any video, image or audio file into a tiny size.</p>
      </div>
      {
        columns.map((column) => (
          <div class="footer-column">
            <h3>{column.title}</h3>
            {column.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <a href="https://codeforreal.com" class="maker" aria-label="Code For Real">
        <span>Made by</span>
        <Image src={CodeForRealLogo} alt="Code For Real" class="maker-logo" />
      </a>
      <p>&copy; {year} Code For Real</p>
      <SocialLinks />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 40px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }
  .brand img {
    border-radius: 7px;
  }
  .footer-brand p {
    margin-top: 14px;
    max-width: 300px;
    font-size: 14px;
    color: var(--text-faint);
  }
  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }
  .footer-column h3 {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 4px;
  }
  .footer-column a {
    color: var(--text-faint);
    transition: color 0.15s ease;
  }
  .footer-column a:hover {
    color: var(--text);
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-faint);
  }
  .footer-bottom p {
    font-size: 13px;
    color: var(--text-faint);
  }
  .maker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }
  .maker-logo {
    width: 120px;
    height: auto;
    opacity: 0.55;
    transition: opacity 0.15s ease;
  }
  .maker:hover .maker-logo {
    opacity: 0.85;
  }
  .footer-bottom :global(.social-links) {
    color: var(--text-faint);
  }
  @media (max-width: 720px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
