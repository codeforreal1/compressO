---
import { getCollection, render } from "astro:content";

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import OGImage from "../assets/og.jpg";

// The app's CHANGELOG.md, as it is when the site is built (see `content.config.ts`)
const [changelog] = await getCollection("changelog");
const { Content } = await render(changelog);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Changelog | CompressO"
      description="What's new in CompressO?"
      image={OGImage}
    />
  </head>
  <body>
    <Header />
    <main class="changelog-page">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">Changelog</span>
          <h1 class="section-title">What's new in CompressO?</h1>
          <p class="section-subtitle">
            Every version, with its new features, improvements and fixes.
          </p>
        </header>
        <article class="changelog">
          <Content />
        </article>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .changelog-page {
    padding: 160px 0 96px;
  }
  .changelog {
    max-width: 760px;
    margin: 56px auto 0;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.7;
  }
  /* The file's own title, already shown above */
  .changelog :global(h1) {
    display: none;
  }
  /* A version */
  .changelog :global(h3) {
    margin: 56px 0 20px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .changelog :global(h3:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .changelog :global(h4) {
    margin: 24px 0 8px;
    font-size: 16px;
    color: var(--text);
  }
  .changelog :global(p) {
    margin: 16px 0 8px;
  }
  .changelog :global(ul) {
    margin: 8px 0 0;
    padding-left: 20px;
    list-style: disc;
  }
  .changelog :global(li) {
    margin: 6px 0;
  }
  .changelog :global(li::marker) {
    color: var(--text-faint);
  }
  .changelog :global(strong) {
    font-weight: 500;
    color: var(--text);
  }
  .changelog :global(a) {
    color: var(--brand);
  }
  .changelog :global(a:hover) {
    text-decoration: underline;
  }
  .changelog :global(code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-raised);
    font-size: 13px;
  }
  @media (max-width: 720px) {
    .changelog-page {
      padding-top: 120px;
    }
  }
</style>
