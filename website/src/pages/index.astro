---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import {
  getLatestRelease,
  getDownloadAssets,
  fetchGitHubStars,
} from "../utils/github";
import OGImage from "../assets/og.jpg";
import aboutImage from "../assets/about.jpg";
import privateImage from "../assets/private.jpg";
import featuresImage from "../assets/features.jpg";
import heroImage from "../assets/hero.jpg";
import HeroAnimatedContent from "../components/HeroAnimatedContent";

const latestRelease = await getLatestRelease();
const downloads = getDownloadAssets(latestRelease.tag_name);
const githubStars = await fetchGitHubStars();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image={OGImage}
    />
  </head>
  <body>
    <Header />
    <section class="hero w-[95vw]! xl:w-[90vw]!">
      <div class="hero-content">
        <HeroAnimatedContent client:visible />
        <p>
          A free & open-source video/image compression app for Mac, Windows & Linux.
          No signup, no cloud uploads, no tracking.
        </p>
        <div class="cta-group">
          <a href="#downloads" class="btn btn-primary h-9! text-zinc-900!">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download
          </a>
          <a
            href="https://github.com/codeforreal1/compressO"
            class="btn btn-secondary h-9!"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            GitHub <span id="github-stars">{githubStars ? githubStars.toLocaleString() : ""} ★</span>
          </a>
        </div>
        <div class="hero-image rounded-[46px]!">
          <img src={heroImage.src} alt="CompressO Interface" />
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">
            Powerful compression.<br />
            Zero compromise
          </h2>
          <p class="section-subtitle">
            Industry-leading algorithms with a focus on privacy and simplicity.
          </p>
        </div>

        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h3>100% Offline</h3>
            <p>
              Your videos never leave your device. All compression happens
              locally, ensuring complete privacy.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <h3>Lightning Fast</h3>
            <p>Powered by the latest FFmpeg. Compress videos within seconds.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <h3>Smart Compression</h3>
            <p>
              Advanced algorithms maintain visual quality while dramatically
              reducing file size.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
            <h3>Simple Interface</h3>
            <p>
              Drag & drop, copy-paste, or select files. No complicated settings
              required.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
            <h3>Universal Format</h3>
            <p>
              Support for all major formats including MP4, MOV, AVI, and
              more. Export to any format you need.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </div>
            <h3>Quality Control</h3>
            <p>
              Fine-tune settings to balance file size and quality.
              Preview results before saving.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>
    <section class="section showcase-section">
      <div class="container">
        <div class="showcase-content">
          <div class="showcase-text">
            <h2>Packed with everything<br />you need</h2>
            <p>
              Beyond simple compression — a comprehensive video processing tool
              for power users and casual users alike.
            </p>
            <ul class="feature-list feature-list-vertical" id="featureList">
              <li>
                <div class="feature-item-content">
                  <strong>Batch Compression</strong>
                  <span>Process multiple videos and images at once</span>
                </div>
              </li>
              <li>
                <div class="feature-item-content">
                  <strong>Video Editing</strong>
                  <span>Trim, split, crop, rotate, flip, and zoom before compression</span>
                </div>
              </li>
              <li>
                <div class="feature-item-content">
                  <strong>Image Editing</strong>
                  <span>Crop, rotate, flip, and adjust dimensions</span>
                </div>
              </li>
              <li>
                <div class="feature-item-content">
                  <strong>Video Controls</strong>
                  <span>Codec, quality, dimensions, resolution, FPS, speed, format</span>
                </div>
              </li>
              <li>
                <div class="feature-item-content">
                  <strong>Image Controls</strong>
                  <span>Quality, format, and optimization for JPEG, PNG, WebP, GIF</span>
                </div>
              </li>
              <li>
                <div class="feature-item-content">
                  <strong>Audio Controls</strong>
                  <span>Codec, volume, channels, bitrate, and audio tracks</span>
                </div>
              </li>
              <li>
                <div class="feature-item-content">
                  <strong>Clipboard Support</strong>
                  <span>Paste files and directories directly from clipboard</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>Format Conversion</strong>
                  <span>Convert between JPEG, PNG, WebP, GIF, and video formats</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>SVG Conversion</strong>
                  <span>Convert SVG to PNG, JPEG, or WebP with rasterization settings</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>GIF Tools</strong>
                  <span>Create animated GIFs from videos and compress existing GIFs</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>Comparison Slider</strong>
                  <span>Interactive before/after comparison for images and videos</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>Drag & Drop</strong>
                  <span>Drop entire folders for automatic batch compression</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>File Explorer Integration</strong>
                  <span>Right-click to "Open with CompressO" from your file manager</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>Metadata Info</strong>
                  <span>View dimensions, format, EXIF data, streams, subtitles, chapters</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>Copy to Clipboard</strong>
                  <span>Copy compressed files directly to clipboard</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>Metadata Editing</strong>
                  <span>Edit title, artist, album, year, genre, copyright and more</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>Image Metadata</strong>
                  <span>Preserve EXIF and other metadata when compressing images</span>
                </div>
              </li>
              <li class="feature-hidden">
                <div class="feature-item-content">
                  <strong>Custom Thumbnails</strong>
                  <span>Set custom thumbnails for video previews in file managers</span>
                </div>
              </li>
            </ul>
            <button class="show-all-btn" id="showAllBtn">See More Features</button>
          </div>
          <div class="showcase-visual">
            <img
              src={featuresImage.src}
              alt="CompressO Features"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section showcase-section">
      <div class="container">
        <div class="showcase-content">
          <div class="showcase-visual">
            <img src={privateImage.src} alt="Privacy First" loading="lazy" />
          </div>
          <div class="showcase-text">
            <h2>Your videos stay yours.<br />Always.</h2>
            <p>
              Unlike online compression services, CompressO never uploads your
              files. No account required. No tracking. No data collection.
            </p>
            <ul class="feature-list">
              <li>No internet connection required</li>
              <li>No user accounts or sign-ups</li>
              <li>No file size limits</li>
              <li>No watermarks</li>
              <li>No tracking</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <section class="section showcase-section">
      <div class="container">
        <div class="showcase-content">
          <div class="showcase-text">
            <h2>Free & Open Source.<br />Forever.</h2>
            <p>
              The code is available on GitHub. Audit it, contribute to it, or
              fork it for your own projects.
            </p>
            <ul class="feature-list">
              <li>MIT License — use it anywhere</li>
              <li>Transparent development on GitHub</li>
              <li>Community-driven features</li>
              <li>Regular updates and improvements</li>
              <li>No hidden costs or premium tiers</li>
            </ul>
            <a
              href="https://github.com/codeforreal1/compressO"
              class="github-link"
              style="margin-top: 20px;"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
              Star on GitHub
            </a>
          </div>
          <div class="showcase-visual">
            <img src={aboutImage.src} alt="Open Source" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>
    <section class="section cta-section">
      <img
          src="/app-icon.png"
          alt="Compresso Logo"
          class="w-24 h-auto block mx-auto!"
      />
      <div class="container">
        <h2>Ready to compress?</h2>
        <div id="downloads" class="downloads-section">
          <h3>Direct Downloads</h3>
          <div class="downloads-grid">
            <div class="download-column">
              <div class="download-os-header">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                  <path d="M2 17l10 5 10-5"></path>
                  <path d="M2 12l10 5 10-5"></path>
                </svg>
                macOS
              </div>
              <div
                class="download-btn"
                style="cursor: default; border-style: dashed;"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                <code
                  id="brew-command"
                  style="font-size: 12px; padding: 2px 6px; border-radius: 3px; text-align: left; flex: 1; background: transparent; color: rgba(255,255,255,0.7);"
                  >brew install codeforreal1/tap/compresso</code
                >
                <button
                  id="copy-brew-btn"
                  class="copy-btn"
                  aria-label="Copy Homebrew command"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"
                    ></rect>
                    <path
                      d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                    ></path>
                  </svg>
                </button>
              </div>
              <a href={downloads.mac.aarch64} class="download-btn">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Apple Silicon <span class="arch-badge">aarch64</span>
              </a>
              <a href={downloads.mac.x64} class="download-btn">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Intel <span class="arch-badge">x64</span>
              </a>
            </div>

            <div class="download-column">
              <div class="download-os-header">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="M4 4l16 0"></path>
                  <path d="M4 12l16 0"></path>
                  <path d="M4 20l16 0"></path>
                  <circle cx="7" cy="4" r="2" fill="currentColor"></circle>
                  <circle cx="17" cy="12" r="2" fill="currentColor"></circle>
                  <circle cx="10" cy="20" r="2" fill="currentColor"></circle>
                </svg>
                Linux
              </div>
              <a href={downloads.linux.appImage} class="download-btn">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                AppImage <span class="arch-badge">amd64</span>
              </a>
              <a href={downloads.linux.deb} class="download-btn">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Debian/Ubuntu <span class="arch-badge">deb</span>
              </a>
            </div>

            <div class="download-column">
              <div class="download-os-header">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"
                  ></path>
                </svg>
                Windows
              </div>
              <a href={downloads.windows.x64} class="download-btn">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Installer <span class="arch-badge">x64</span>
              </a>
            </div>
          </div>
          <div class="version-badge">v{downloads.version}</div>
        </div>
      </div>
    </section>
    <Footer />

    <script is:inline>
      const showAllBtn = document.getElementById("showAllBtn");
      const hiddenFeatures = document.querySelectorAll(".feature-hidden");

      showAllBtn?.addEventListener("click", () => {
        hiddenFeatures.forEach((feature) => {
          feature.classList.remove("feature-hidden");
        });
        showAllBtn.style.display = "none";
      });

      const copyBrewBtn = document.getElementById("copy-brew-btn");
      const brewCommand = document.getElementById("brew-command");

      copyBrewBtn?.addEventListener("click", async () => {
        const text = brewCommand.textContent;
        try {
          await navigator.clipboard.writeText(text);
          copyBrewBtn.classList.add("copied");
          setTimeout(() => {
            copyBrewBtn.classList.remove("copied");
          }, 2000);
        } catch (err) {
          console.error("Failed to copy:", err);
        }
      });
    </script>
  </body>
</html>
