---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import ImageSlot from "../components/ImageSlot.astro";
import HeroAnimatedContent from "../components/HeroAnimatedContent";
import HeroShot from "../components/HeroShot";
import LightRays from "../components/reactbits/LightRays";
import ShinyText from "../components/reactbits/ShinyText";
import BlurText from "../components/reactbits/BlurText";
import CountUp from "../components/reactbits/CountUp";
import SpotlightCard from "../components/reactbits/SpotlightCard";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import {
  getLatestRelease,
  getDownloadAssets,
  fetchGitHubStars,
  LATEST_RELEASE_URL,
} from "../utils/github";
import OGImage from "../assets/og.jpg";
import heroImage from "../assets/hero-app.jpg";
import targetSizeImage from "../assets/target-size.jpg";
import dropZoneImage from "../assets/drop-zone.webp";
import editImage from "../assets/edit-tools.png";

const latestRelease = await getLatestRelease();
const downloads = getDownloadAssets(latestRelease?.tag_name);
const githubStars = await fetchGitHubStars();
const releaseUrl = latestRelease?.html_url ?? LATEST_RELEASE_URL;

/** Every format CompressO opens, in the scrolling strip under the hero */
const formats = [
  "MP4", "MOV", "MKV", "WEBM", "AVI", "M4V", "MTS", "M2TS", "TS",
  "JPG", "PNG", "WEBP", "GIF", "SVG", "AVIF", "HEIC", "JXL", "BMP", "TIFF",
  "MP3", "AAC", "FLAC", "WAV", "OGG", "OPUS", "M4A", "AIFF",
];

/** The main features, as a bento grid; `span` is the number of columns of 12 */
const highlights: {
  icon: IconName;
  title: string;
  description: string;
  image: string;
  /** The screenshot (or an illustration in `public/features`); a placeholder labeled `image` without one */
  src?: ImageMetadata | string;
  span: string;
}[] = [
  {
    icon: "target",
    title: "Compress to an exact size",
    description:
      "Need a video under 10 MB for an email, or a photo under 500 KB for a form? Choose the size, and CompressO finds the best quality that fits, for videos, images and audio. Videos keep their resolution where they can, and you can pick another attempt if you prefer it.",
    image: "The Target Size setting",
    src: targetSizeImage,
    span: "lg:col-span-7",
  },
  {
    icon: "menuBar",
    title: "Compress from the menu bar",
    description:
      "Drop or paste files on the menu bar on macOS, or the system tray on Windows. CompressO compresses them automatically while you keep working.",
    image: "The drop zone in the menu bar",
    src: dropZoneImage,
    span: "lg:col-span-5",
  },
  {
    icon: "folderWatch",
    title: "Watch folders",
    description:
      "Choose a folder, such as your screen recordings or downloads, and every new file in it is compressed automatically.",
    image: "New recordings in a watched folder, compressed automatically",
    src: "/features/watch-folder.svg",
    span: "lg:col-span-4",
  },
  {
    icon: "presets",
    title: "Presets",
    description:
      "Save the settings you use most, each with its own save location, and apply them to any video, image or audio file.",
    image: "The preset menu",
    src: "/features/presets.svg",
    span: "lg:col-span-4",
  },
  {
    icon: "folders",
    title: "Batch compression",
    description:
      "Compress whole folders at once, keep their folder structure, and pause at any time. Videos, images and audio are compressed side by side.",
    image: "Videos, images and audio compressing side by side",
    src: "/features/batch.svg",
    span: "lg:col-span-4",
  },
  {
    icon: "crop",
    title: "Edit before you compress",
    description:
      "Trim, crop, rotate and flip videos and images, with a live preview.",
    image: "Crop ratios, rotate, flip and zoom controls",
    src: editImage,
    span: "lg:col-span-4",
  },
  {
    icon: "bolt",
    title: "Hardware acceleration",
    description:
      "Use the graphics card to compress videos faster, on Mac, Windows and Linux.",
    image: "Compressing faster with the graphics card",
    src: "/features/hardware-acceleration.svg",
    span: "lg:col-span-4",
  },
  {
    icon: "globe",
    title: "Speaks your language",
    description:
      "Available in 16 languages, including Chinese, Spanish, German, Japanese and Hindi.",
    image: "The 16 languages of CompressO",
    src: "/features/languages.svg",
    span: "lg:col-span-4",
  },
];

/** Everything else, as a compact list */
const moreFeatures = [
  { title: "See the difference", description: "Compare the original and the compressed file before saving it." },
  { title: "Compression history", description: "Every compression, and the space saved in total." },
  { title: "Format conversion", description: "Convert between video, image and audio formats." },
  { title: "Audio compression", description: "Compress audio files, or extract the audio of a video." },
  { title: "GIF tools", description: "Create GIFs from videos and compress existing GIFs." },
  { title: "SVG conversion", description: "Convert SVG to PNG, JPEG or WebP, and back." },
  { title: "Video controls", description: "Codec, quality, resolution, frame rate and speed." },
  { title: "Audio controls", description: "Codec, volume, channels, bitrate and audio tracks." },
  { title: "Subtitles", description: "Add, keep and extract subtitle tracks." },
  { title: "Metadata", description: "Edit, keep or remove titles, dates and other details." },
  { title: "Custom thumbnails", description: "Choose the thumbnail shown for a video." },
  { title: "Media information", description: "Streams, codecs, chapters and EXIF data." },
  { title: "Clipboard", description: "Paste files to compress, and copy the results." },
  { title: "Saving your way", description: "Ask every time, save to a folder, next to the original, or replace it." },
  { title: "Modern image formats", description: "Open and convert JPEG XL, HEIC and AVIF images." },
  { title: "Open with CompressO", description: "Open files from Finder or File Explorer." },
  { title: "Keeps the computer awake", description: "Long compressions are not interrupted by sleep." },
  { title: "Completion sound", description: "Hear when a compression is done." },
];

const privacyPoints: { icon: IconName; title: string; description: string }[] = [
  { icon: "wifiOff", title: "Works offline", description: "No internet connection is needed to compress." },
  { icon: "userOff", title: "No account", description: "No sign-up, no login and no email address." },
  { icon: "infinity", title: "No limits", description: "No file size limits and no daily quotas." },
  { icon: "noMark", title: "No watermarks", description: "Your files stay exactly as you made them." },
  { icon: "eyeOff", title: "No tracking", description: "The app collects no data about you or your files." },
  { icon: "lock", title: "Stays on your computer", description: "Files are never uploaded anywhere." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={OGImage} />
  </head>
  <body>
    <Header />

    <main class="home">
      <!-- Hero -->
      <section class="hero">
        <div class="hero-rays" aria-hidden="true">
          <LightRays
            client:only="react"
            raysOrigin="top-center"
            raysColor="#ffffff"
            raysSpeed={0.6}
            lightSpread={0.8}
            rayLength={2.2}
            fadeDistance={1}
            saturation={0}
            followMouse={true}
            mouseInfluence={0.06}
            cursorShadow={false}
            clickPulse={false}
            noiseAmount={0}
            distortion={0}
            opacity={0.8}
          />
        </div>
        <div class="container hero-inner">
          <a href="/blog/compresso-4/" class="announcement">
            <span class="announcement-tag">New in 4.0</span>
            <ShinyText
              client:load
              text="Target size, watch folders and the drop zone"
              color="rgba(245, 244, 242, 0.62)"
              shineColor="#ffffff"
              speed={3}
            />
            <Icon name="arrowRight" size={14} />
          </a>
          <HeroAnimatedContent client:load />
          <p class="hero-subtitle">
            A free and open-source app to compress videos, images and audio on
            Mac, Windows and Linux, even to an exact file size. No sign-up, no
            uploads, no tracking.
          </p>
          <div class="hero-actions">
            <a href="#download" class="btn btn-primary" id="hero-download">
              <Icon name="download" size={18} />
              <span>Download for free</span>
            </a>
            <a href="https://github.com/codeforreal1/compressO" class="btn btn-secondary">
              <Icon name="github" size={18} />
              Star on GitHub
              {githubStars ? (
                <span class="star-count">
                  <Icon name="star" size={14} />
                  <CountUp client:visible to={githubStars} separator="," duration={1.6} />
                </span>
              ) : null}
            </a>
          </div>
          <p class="hero-note">macOS, Windows and Linux · Free forever</p>
          <HeroShot client:load src={heroImage.src} alt="The CompressO window" />
        </div>
      </section>

      <!-- Formats -->
      <section class="formats" aria-label="Supported formats">
        <div class="formats-track">
          {[...formats, ...formats].map((format) => <span>{format}</span>)}
        </div>
      </section>

      <!-- Highlights -->
      <section class="section" id="features">
        <div class="container">
          <div class="section-header reveal">
            <span class="eyebrow">Features</span>
            <BlurText client:visible as="h2" className="section-title justify-center" text="Powerful compression, without the complexity" animateBy="words" direction="bottom" />
            <p class="section-subtitle">
              Everything you need to make files smaller, in an app that stays
              out of your way.
            </p>
          </div>
          <div class="bento">
            {
              highlights.map((item) => (
                <SpotlightCard
                  client:visible
                  className={`bento-card ${item.span}`}
                  style={{ "--spotlight-card-surface": "#121110" }}
                  intensity={0.1}
                  spotlightSize={320}
                >
                  <div class="bento-text">
                    <span class="bento-icon">
                      <Icon name={item.icon} size={18} />
                    </span>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                  <ImageSlot label={item.image} src={item.src} aspect="16 / 9" class="bento-image" />
                </SpotlightCard>
              ))
            }
          </div>
        </div>
      </section>

      <!-- More features -->
      <section class="section section-tight">
        <div class="container">
          <div class="section-header reveal">
            <BlurText client:visible as="h2" className="section-title justify-center" text="And much more" animateBy="words" direction="bottom" />
            <p class="section-subtitle">
              The details that make compressing files quick and pleasant.
            </p>
          </div>
          <ul class="more-grid reveal">
            {
              moreFeatures.map((feature) => (
                <li>
                  <span class="check">
                    <Icon name="check" size={14} />
                  </span>
                  <div>
                    <h3>{feature.title}</h3>
                    <p>{feature.description}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Privacy -->
      <section class="section" id="privacy">
        <div class="container split">
          <div class="split-text reveal">
            <span class="eyebrow">Privacy</span>
            <BlurText client:visible as="h2" className="section-title" text="Your files stay yours. Always." animateBy="words" direction="bottom" />
            <p class="section-subtitle">
              Unlike online compression services, CompressO never uploads your
              files. It does all the work on your own computer.
            </p>
            <div class="privacy-grid">
              {
                privacyPoints.map((point) => (
                  <div class="privacy-item">
                    <Icon name={point.icon} size={20} class="privacy-icon" />
                    <h3>{point.title}</h3>
                    <p>{point.description}</p>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="reveal">
            <ImageSlot
              label="Files stay on your computer and are never uploaded"
              src="/features/privacy.svg"
              aspect="4 / 5"
            />
          </div>
        </div>
      </section>

      <!-- Open source -->
      <section class="section section-tight">
        <div class="container">
          <div class="card open-source reveal">
            <div class="open-source-text">
              <span class="eyebrow">Open source</span>
              <BlurText client:visible as="h2" className="section-title" text="Free and open‑source. Forever." animateBy="words" direction="bottom" />
              <p class="section-subtitle">
                The full source code is on GitHub. Read it, improve it, or build
                on it. Licensed under AGPL-3.0, with no hidden costs and no
                premium tiers.
              </p>
              <div class="open-source-actions">
                <a href="https://github.com/codeforreal1/compressO" class="btn btn-secondary">
                  <Icon name="github" size={18} />
                  View on GitHub
                </a>
                {
                  githubStars ? (
                    <span class="stars">
                      <Icon name="star" size={16} />
                      <CountUp client:visible to={githubStars} separator="," duration={1.6} />
                      stars
                    </span>
                  ) : null
                }
              </div>
            </div>
            <ImageSlot
              label="The CompressO source code, open on GitHub"
              src="/features/open-source.svg"
              aspect="4 / 3"
              class="open-source-image"
            />
          </div>
        </div>
      </section>

      <!-- Download -->
      <section class="section" id="download">
        <div class="container">
          <div class="section-header reveal">
            <img src="/app-icon.png" alt="" width="72" height="72" class="download-icon" />
            <BlurText client:visible as="h2" className="section-title justify-center" text="Ready to compress?" animateBy="words" direction="bottom" />
            <p class="section-subtitle">
              Free for macOS, Windows and Linux.
            </p>
          </div>
          <div class="download-grid reveal">
            <SpotlightCard
              client:visible
              className="download-card"
              data-os="mac"
              style={{ "--spotlight-card-surface": "#121110" }}
              intensity={0.1}
            >
              <div class="download-head">
                <Icon name="apple" size={22} />
                <h3>macOS</h3>
                <span>macOS 13 or newer</span>
              </div>
              <a href={downloads.mac.aarch64} class="btn btn-primary">
                <Icon name="download" size={16} />
                Apple Silicon
              </a>
              <a href={downloads.mac.x64} class="btn btn-secondary">
                <Icon name="download" size={16} />
                Intel
              </a>
              <div class="brew">
                <code id="brew-command">brew install codeforreal1/tap/compresso</code>
                <button type="button" class="brew-copy" id="brew-copy" aria-label="Copy the Homebrew command">
                  <Icon name="copy" size={15} class="icon-copy" />
                  <Icon name="check" size={15} class="icon-copied" />
                </button>
              </div>
            </SpotlightCard>
            <SpotlightCard
              client:visible
              className="download-card"
              data-os="windows"
              style={{ "--spotlight-card-surface": "#121110" }}
              intensity={0.1}
            >
              <div class="download-head">
                <Icon name="windows" size={20} />
                <h3>Windows</h3>
                <span>Windows 10 and 11, 64-bit</span>
              </div>
              <a href={downloads.windows.x64} class="btn btn-primary">
                <Icon name="download" size={16} />
                Installer
              </a>
            </SpotlightCard>
            <SpotlightCard
              client:visible
              className="download-card"
              data-os="linux"
              style={{ "--spotlight-card-surface": "#121110" }}
              intensity={0.1}
            >
              <div class="download-head">
                <Icon name="linux" size={22} />
                <h3>Linux</h3>
                <span>64-bit</span>
              </div>
              <a href={downloads.linux.appImage} class="btn btn-primary">
                <Icon name="download" size={16} />
                AppImage
              </a>
              <a href={downloads.linux.deb} class="btn btn-secondary">
                <Icon name="download" size={16} />
                Debian and Ubuntu
              </a>
            </SpotlightCard>
          </div>
          <p class="download-note">
            <a href={releaseUrl}>Release notes</a>
          </p>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      // Sections fade in as they scroll into view
      const reveals = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        reveals.forEach((element) => observer.observe(element));
      } else {
        reveals.forEach((element) => element.classList.add("is-visible"));
      }

      // The hero button names the visitor's system, and its download card is shown first
      const platform = (navigator.userAgentData?.platform || navigator.platform || "").toLowerCase();
      const os = platform.includes("mac")
        ? { id: "mac", name: "macOS" }
        : platform.includes("win")
          ? { id: "windows", name: "Windows" }
          : platform.includes("linux")
            ? { id: "linux", name: "Linux" }
            : null;
      if (os) {
        const label = document.querySelector("#hero-download span");
        if (label) label.textContent = `Download for ${os.name}`;
        const card = document.querySelector(`.download-card[data-os="${os.id}"]`);
        const item = card?.closest("astro-island") ?? card;
        item?.parentElement?.prepend(item);
      }

      // Copies the Homebrew command
      const copyButton = document.getElementById("brew-copy");
      copyButton?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(
            document.getElementById("brew-command").textContent,
          );
          copyButton.classList.add("copied");
          setTimeout(() => copyButton.classList.remove("copied"), 1800);
        } catch {}
      });
    </script>

    <style>
      .home {
        width: auto;
        max-width: none;
        padding: 0;
      }

      /* Hero */
      .hero {
        position: relative;
        padding: 152px 0 40px;
        text-align: center;
        overflow: hidden;
      }
      /* Soft white light rays from the top of the page (React Bits' Light Rays) */
      .hero-rays {
        position: absolute;
        inset: 0 0 auto 0;
        height: 760px;
        pointer-events: none;
        mask-image: linear-gradient(to bottom, black 55%, transparent);
      }
      .hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .announcement {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 5px 12px 5px 5px;
        margin-bottom: 36px;
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.03);
        font-size: 13px;
        text-align: left;
        color: var(--text-muted);
        transition: border-color 0.15s ease, color 0.15s ease;
      }
      .announcement:hover {
        border-color: rgba(255, 255, 255, 0.22);
        color: var(--text);
      }
      .announcement-tag {
        flex-shrink: 0;
        white-space: nowrap;
        padding: 2px 9px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
        font-weight: 500;
      }
      :global(.hero-icon) {
        display: block;
        margin: 0 auto;
        border-radius: 20px;
      }
      :global(.hero-title) {
        font-size: clamp(44px, 8.2vw, 88px);
        font-weight: 700;
        line-height: 1.02;
        letter-spacing: -0.045em;
        color: var(--text);
      }
      :global(.hero-title-line) {
        display: block;
      }
      /* The last word, framed like a selected layer in a design tool (see SelectionWord.tsx) */
      :global(.selection) {
        position: relative;
        display: inline-flex;
        margin-top: 0.12em;
        padding: 0 0.16em;
        border: 1.5px solid rgba(255, 132, 0, 0.85);
        background: rgba(255, 132, 0, 0.05);
        vertical-align: top;
      }
      :global(.selection-clip) {
        display: inline-flex;
        overflow: hidden;
        padding: 0.02em 0 0.14em;
      }
      :global(.selection-word) {
        display: inline-block;
        white-space: nowrap;
        line-height: 1.02;
      }
      :global(.selection-handle) {
        position: absolute;
        width: 11px;
        height: 11px;
        border: 1.5px solid var(--brand);
        background: var(--bg);
        z-index: 1;
      }
      :global(.selection-handle-tl) { top: -6px; left: -6px; }
      :global(.selection-handle-tr) { top: -6px; right: -6px; }
      :global(.selection-handle-bl) { bottom: -6px; left: -6px; }
      :global(.selection-handle-br) { bottom: -6px; right: -6px; }
      .hero-subtitle {
        max-width: 560px;
        margin-top: 36px;
        font-size: clamp(16px, 2vw, 19px);
        line-height: 1.6;
      }
      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 36px;
      }
      .star-count {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding-left: 10px;
        margin-left: 2px;
        border-left: 1px solid var(--border-strong);
        color: var(--text-muted);
      }
      .hero-note {
        margin-top: 16px;
        font-size: 13px;
        color: var(--text-faint);
      }
      /* The screenshot, which straightens as the page scrolls (see components/HeroShot.tsx) */
      /*
       * Wider than the page's content, running off the screen's edges on smaller screens. The tilt
       * never grows the image past this box (see .hero-shot), as the fading mask below would cut it.
       */
      :global(.hero-shot-stage) {
        flex-shrink: 0;
        width: min(1720px, 112vw);
        margin-top: 72px;
        /* The app fades into the page at its bottom */
        mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
      }
      :global(.hero-shot) {
        padding: 8px;
        border: 1px solid var(--border-strong);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.03);
        /* Tilted at the bottom edge, so the top leans away and nothing grows past the screen */
        transform-origin: center bottom;
        will-change: transform;
      }
      :global(.hero-shot) {
        position: relative;
      }
      :global(.hero-shot-media) {
        position: relative;
        overflow: hidden;
        border-radius: 17px;
      }
      :global(.hero-shot-media img) {
        display: block;
        width: 100%;
      }
      /* The compression card, over the screenshot: a ring filling up, & the size counting down */
      :global(.compress-card) {
        position: absolute;
        top: 16%;
        left: 50%;
        translate: -50% 0;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 16px 22px 16px 16px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(14, 13, 12, 0.62);
        backdrop-filter: blur(22px) saturate(160%);
        -webkit-backdrop-filter: blur(22px) saturate(160%);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.1),
          0 30px 80px rgba(0, 0, 0, 0.6);
        text-align: left;
        white-space: nowrap;
        transition:
          border-color 0.4s ease,
          box-shadow 0.4s ease;
      }
      :global(.compress-card.is-done) {
        border-color: var(--brand-line);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.1),
          0 30px 80px rgba(0, 0, 0, 0.6),
          0 0 60px rgba(255, 132, 0, 0.28);
      }
      :global(.compress-ring) {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 76px;
        height: 76px;
        flex-shrink: 0;
      }
      :global(.compress-ring > svg:first-child) {
        position: absolute;
        inset: 0;
        transform: rotate(-90deg);
        overflow: visible;
      }
      :global(.compress-ring-track) {
        fill: none;
        stroke: rgba(255, 255, 255, 0.1);
        stroke-width: 6;
      }
      :global(.compress-ring-fill) {
        fill: none;
        stroke: var(--brand);
        stroke-width: 6;
        stroke-linecap: round;
      }
      :global(.compress-ring-percent) {
        font-size: 17px;
        font-weight: 600;
        color: var(--text);
        font-variant-numeric: tabular-nums;
      }
      :global(.compress-ring-check) {
        width: 28px;
        height: 28px;
        color: var(--brand);
      }
      :global(.compress-card-text) {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      :global(.compress-card-status) {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text-muted);
      }
      :global(.compress-card.is-done .compress-card-status) {
        color: var(--brand);
      }
      :global(.compress-card-pulse) {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--brand);
        box-shadow: 0 0 0 0 rgba(255, 132, 0, 0.6);
        animation: compress-pulse 1.4s ease-out infinite;
      }
      @keyframes compress-pulse {
        to {
          box-shadow: 0 0 0 10px rgba(255, 132, 0, 0);
        }
      }
      :global(.compress-card-size) {
        font-size: 34px;
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--text);
        font-variant-numeric: tabular-nums;
      }
      :global(.compress-card-size span) {
        margin-left: 5px;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0;
        color: var(--text-faint);
      }
      :global(.compress-card-from) {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--text-faint);
        font-variant-numeric: tabular-nums;
      }
      :global(.compress-card-saved) {
        padding: 1px 7px;
        border-radius: 999px;
        background: var(--brand-soft);
        color: var(--brand);
        font-weight: 600;
      }
      /* Small screens: a compact card, so it does not cover the screenshot */
      @media (max-width: 720px) {
        :global(.compress-card) {
          top: 7%;
          gap: 8px;
          padding: 5px 12px 5px 5px;
        }
        :global(.compress-ring) {
          width: 34px;
          height: 34px;
        }
        :global(.compress-ring-track),
        :global(.compress-ring-fill) {
          stroke-width: 8;
        }
        :global(.compress-ring-fill) {
          filter: none;
        }
        :global(.compress-ring-percent) {
          font-size: 9px;
        }
        :global(.compress-ring-check) {
          width: 14px;
          height: 14px;
        }
        :global(.compress-card-text) {
          gap: 1px;
        }
        :global(.compress-card-status) {
          gap: 5px;
          font-size: 10px;
        }
        :global(.compress-card-pulse) {
          width: 5px;
          height: 5px;
        }
        :global(.compress-card-detail),
        :global(.compress-card-from) {
          display: none;
        }
        :global(.compress-card-size) {
          font-size: 15px;
        }
        :global(.compress-card-size span) {
          margin-left: 3px;
          font-size: 10px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        :global(.compress-card-pulse) {
          animation: none;
        }
      }

      /* Formats */
      .formats {
        padding: 28px 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        overflow: hidden;
        mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
      }
      .formats-track {
        display: flex;
        width: max-content;
        gap: 48px;
        animation: var(--animate-marquee);
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--text-faint);
      }
      @media (prefers-reduced-motion: reduce) {
        .formats-track {
          animation: none;
        }
      }

      /* Bento */
      .bento {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 16px;
      }
      :global(.bento-card) {
        grid-column: span 12;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 28px;
        padding: 28px;
        border-radius: var(--radius-lg);
      }
      @media (min-width: 768px) {
        :global(.bento-card) {
          grid-column: span 6;
        }
      }
      @media (min-width: 1024px) {
        :global(.bento-card.lg\:col-span-4) { grid-column: span 4; }
        :global(.bento-card.lg\:col-span-5) { grid-column: span 5; }
        :global(.bento-card.lg\:col-span-7) { grid-column: span 7; }
      }
      .bento-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        margin-bottom: 18px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--border);
        color: var(--text);
      }
      .bento-text h3 {
        font-size: 19px;
        margin-bottom: 8px;
      }
      .bento-text p {
        font-size: 15px;
        line-height: 1.6;
      }

      /* More features */
      .section-tight {
        padding-top: 64px;
      }
      .more-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 28px 32px;
      }
      .more-grid li {
        display: flex;
        gap: 12px;
      }
      .check {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        margin-top: 1px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.07);
        color: var(--text-muted);
      }
      .more-grid h3 {
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 4px;
        letter-spacing: -0.01em;
      }
      .more-grid p {
        font-size: 14px;
        line-height: 1.5;
        color: var(--text-faint);
      }

      /* Privacy */
      .split {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 64px;
        align-items: center;
      }
      .split-text .section-subtitle {
        max-width: 520px;
      }
      .privacy-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px 32px;
        margin-top: 40px;
      }
      :global(.privacy-icon) {
        color: var(--text-muted);
        margin-bottom: 10px;
      }
      .privacy-item h3 {
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 4px;
      }
      .privacy-item p {
        font-size: 14px;
        line-height: 1.5;
        color: var(--text-faint);
      }

      /* Open source */
      .open-source {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: center;
        padding: 56px;
      }
      .open-source-actions {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 32px;
      }
      .stars {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        color: var(--text-muted);
      }
      .stars :global(svg) {
        color: var(--text-muted);
      }

      /* Download */
      .download-icon {
        display: block;
        margin: 0 auto 24px;
        border-radius: 16px;
      }
      .download-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        max-width: 960px;
        margin: 0 auto;
      }
      :global(.download-card) {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 28px;
        border-radius: var(--radius-lg);
      }
      .download-head {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 12px;
      }
      .download-head :global(svg) {
        margin-bottom: 10px;
      }
      .download-head h3 {
        font-size: 19px;
      }
      .download-head span {
        font-size: 13px;
        color: var(--text-faint);
      }
      :global(.download-card .btn) {
        width: 100%;
      }
      .brew {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
        padding: 8px 8px 8px 12px;
        border: 1px dashed var(--border-strong);
        border-radius: 10px;
      }
      .brew code {
        flex: 1;
        overflow-x: auto;
        white-space: nowrap;
        font-size: 12px;
        color: var(--text-muted);
      }
      .brew-copy {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        border: none;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.06);
        color: var(--text-muted);
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .brew-copy:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--text);
      }
      .brew-copy :global(.icon-copied),
      .brew-copy.copied :global(.icon-copy) {
        display: none;
      }
      .brew-copy.copied :global(.icon-copied) {
        display: block;
        color: var(--text);
      }
      .download-note {
        margin-top: 28px;
        text-align: center;
        font-size: 14px;
      }
      .download-note a {
        color: var(--text-muted);
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 4px;
        transition: color 0.15s ease;
      }
      .download-note a:hover {
        color: var(--text);
      }

      @media (max-width: 900px) {
        .split,
        .open-source {
          grid-template-columns: 1fr;
        }
        .open-source {
          padding: 32px;
        }
        .download-grid {
          grid-template-columns: 1fr;
          max-width: 420px;
        }
      }
      @media (max-width: 560px) {
        .privacy-grid {
          grid-template-columns: 1fr;
        }
        .hero-actions {
          flex-direction: column;
          width: 100%;
        }
        .hero-actions .btn {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
