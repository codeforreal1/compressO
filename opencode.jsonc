{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "compresso": {
        "type": "local",
        "command": ["compresso", "mcp"],
      },
    },
  },
  "plugins": [
    {
      "package": "opencode-tps-meter@latest",
      "options": { "showElapsed": true, "enableColorCoding": true },
    },
  ],
}
